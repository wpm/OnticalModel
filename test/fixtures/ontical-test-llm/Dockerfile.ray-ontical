FROM rayproject/ray:latest

# Set working directory
WORKDIR /workspace

# Copy project files
COPY . /workspace

# Install OnticalModel package, coverage, and fix msgpack dependency conflict
RUN pip install -e . && \
    pip install --upgrade 'msgpack>=1.1.1' && \
    pip install 'coverage[toml]>=7.0.0'

# Add workspace to PYTHONPATH so test module is importable
ENV PYTHONPATH=/workspace:$PYTHONPATH

# Set default command (will be overridden in docker-compose)
CMD ["bash"]
